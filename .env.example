APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-at-least-48-random-characters
SESSION_TTL_MINUTES=480
ACTION_TTL_MINUTES=15

# Groq is optional but recommended for language planning and answer phrasing.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
ALLOW_SAFE_LLM_FALLBACK=true

# Learned semantic embeddings run locally; no API key and no hashing.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_BACKEND=chroma
EMBEDDING_CACHE_DIR=runtime/model_cache

LOG_LEVEL=INFO
MAX_MESSAGE_CHARS=4000
LOGIN_RATE_LIMIT_PER_MINUTE=8
